{
  "Authentication": {
    "ApiKey": "cash_flow_local_api_key"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=cash_flow;Username=cash_flow_user;Password=cash_flow_password",
    "Redis": "localhost:6379,password=cash_flow_redis_password,abortConnect=false"
  },
  "Redis": {
    "InstanceName": "cash-flow:",
    "DailyBalanceTtlMinutes": 15
  },
  "Outbox": {
    "BatchSize": 20,
    "MaxRetryCount": 5,
    "RetryDelaySeconds": 30,
    "PublishIntervalSeconds": 5
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "cash_flow_user",
    "Password": "cash_flow_password",
    "VirtualHost": "/",
    "Exchange": "cash-flow.events",
    "Queue": "cash-flow.entry-created",
    "RoutingKey": "entry.created"
  }
}
